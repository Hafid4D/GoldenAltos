{
    "tableDataSource": "Form.sfw.lb_items",
    "columns": [{
            "check": true,
            "header": "Division",
            "source": "ds.Division.query(\"divisionID =:1\";This.item.divisionID).first().name"
        }, {
            "check": true,
            "header": "Internal part#",
            "source": "This.item.partData.internalPartNum"
        }, {
            "check": true,
            "header": "Vendor",
            "source": "This.item.vendorPartnum"
        }
        , {
            "check": true,
            "header": "Comments",
            "source": "This.item.comment"
        }, {
            "check": true,
            "header": "Critical?",
            "source": "This.item.critical?\"Yes\":\"No\""
        }
    ]
   
}